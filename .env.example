# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE - Database & Backend
# ─────────────────────────────────────────────────────────────────────────────

# Tu URL de proyecto Supabase
# Obtén de: https://app.supabase.com/project/[PROJECT]/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (solo server-side, NUNCA en frontend)
# Obtén de: https://app.supabase.com/project/[PROJECT]/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon Key (público, puede estar en frontend como NEXT_PUBLIC_)
# Obtén de: https://app.supabase.com/project/[PROJECT]/settings/api
SUPABASE_ANON_KEY=your_anon_key_here

# ─────────────────────────────────────────────────────────────────────────────
# GROQ - LLM API para análisis
# ─────────────────────────────────────────────────────────────────────────────

# API Key para Groq API (modelos: llama-3.3-70b-versatile, etc)
# Obtén de: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND - Next.js
# ─────────────────────────────────────────────────────────────────────────────

# URL del backend (accesible desde el navegador)
# En desarrollo: http://localhost:8000
# En producción: https://api.tudominio.com
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND - FastAPI
# ─────────────────────────────────────────────────────────────────────────────

# Modelos de embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Puerto (modificar si está en uso)
BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# OPCIONALES - Para desarrollo avanzado
# ─────────────────────────────────────────────────────────────────────────────

# Debug mode (mostrar logs detallados)
# DEBUG=false

# CORS settings para producción
# CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Rate limiting
# RATE_LIMIT_PER_MINUTE=60
